# Gemini API Key (Get one at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Local-First LLM (Ollama / LM Studio / OpenAI-compatible server)
# When set, Aura routes requests locally first and falls back to Gemini if offline
# AURA_LOCAL_LLM_URL=http://192.168.1.20:11434/v1
# AURA_LOCAL_LLM_MODEL=llama3.2
# AURA_LOCAL_LLM_KEY=

# Android TV Network Configuration
AURA_TV_IP=192.168.1.100
AURA_TV_PORT=8765

# Optional: Override auto-detected 2-letter country code (e.g. US, GB, IN, JP, DE)
# Leave unset to auto-detect from your TV's timezone/locale
# AURA_REGION=US

# Companion Host / Phone Server URLs (Optional — TV also runs standalone)
AURA_HOST_URL=http://192.168.1.20:7070
AURA_PHONE_URL=http://192.168.1.21:7070

# Household Profile Display Names
AURA_DEFAULT_PROFILE=member1
AURA_MEMBER1_NAME=Member 1
AURA_PARTNER_NAME=Partner
AURA_MEMBER3_NAME=Member 3
AURA_KIDS_NAME=Kids
AURA_FAMILY_NAME=Family
